# Cổng chạy server
PORT=3000

# Phiên bản Graph API (xem https://developers.facebook.com/docs/graph-api/changelog)
GRAPH_VERSION=v23.0

# Thông tin ứng dụng Facebook (developers.facebook.com -> App -> Settings -> Basic)
FB_APP_ID=
FB_APP_SECRET=

# Chuỗi bí mật tự đặt, dùng khi cấu hình Webhook trên Facebook (Verify Token)
FB_VERIFY_TOKEN=doi-chuoi-nay-thanh-bi-mat-cua-ban

# URL công khai HTTPS của server (ví dụ https://abc.trycloudflare.com). Dùng cho webhook và đăng nhập Facebook.
# Để trống khi chạy trên máy: đăng nhập Facebook vẫn hoạt động với http://localhost
PUBLIC_URL=

# Có thể nhập FB_APP_ID / FB_APP_SECRET / FB_VERIFY_TOKEN trực tiếp trong giao diện (mục Kết nối) thay vì ở đây.

# Mật khẩu bảo vệ giao diện quản lý (để trống = không hỏi mật khẩu, chỉ nên dùng trên máy cá nhân)
ADMIN_PASSWORD=

# Chu kỳ đồng bộ dữ liệu từ Graph API (giây). 0 = tắt đồng bộ định kỳ, chỉ nhận qua webhook
SYNC_INTERVAL_SEC=120

# Đường dẫn file CSDL SQLite
DB_PATH=./data/fanpage.db

# Chế độ demo (dữ liệu giả, không gọi Facebook). Có thể chạy `npm run demo` thay vì đặt biến này
DEMO=0
